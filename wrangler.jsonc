{
  // Aura is a static PWA: Cloudflare serves the built app/ folder, there is no Worker script.
  // Build: `sh build.sh` (needs GOOGLE_CLIENT_ID and GOOGLE_PICKER_KEY as build variables). Deploy: `npx wrangler deploy`.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aura",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./app"
  },
  // The Worker must be in the same Cloudflare account as the allo.land zone; deploy creates the DNS record.
  "routes": [{ "pattern": "aura.allo.land", "custom_domain": true }]
}
